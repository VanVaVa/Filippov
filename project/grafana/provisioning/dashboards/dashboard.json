{
  "dashboard": {
    "title": "HR Platform API Metrics",
    "tags": ["hr-platform", "api"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "HTTP Requests Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(http_requests_received_total[5m])) by (code, method)",
            "legendFormat": "{{method}} {{code}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "yaxes": [
          {
            "format": "reqps"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 2,
        "title": "HTTP Request Duration (95th percentile)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, method))",
            "legendFormat": "{{method}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "yaxes": [
          {
            "format": "s"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 3,
        "title": "Requests by Status Code",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum(rate(http_requests_received_total[5m])) by (code)",
            "legendFormat": "{{code}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 4,
        "title": "HTTP Requests In Flight",
        "type": "graph",
        "targets": [
          {
            "expr": "http_requests_in_flight",
            "legendFormat": "In Flight",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      },
      {
        "id": 5,
        "title": "Total Requests",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(http_requests_received_total)",
            "legendFormat": "Total",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 16
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          }
        }
      },
      {
        "id": 6,
        "title": "Average Response Time",
        "type": "stat",
        "targets": [
          {
            "expr": "avg(http_request_duration_seconds)",
            "legendFormat": "Average",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 16
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 7,
        "title": "Request Rate (req/s)",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(http_requests_received_total[5m]))",
            "legendFormat": "Rate",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 12,
          "y": 16
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          }
        }
      },
      {
        "id": 8,
        "title": "Active Requests",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(http_requests_in_flight)",
            "legendFormat": "Active",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 18,
          "y": 16
        }
      }
    ],
    "refresh": "10s",
    "schemaVersion": 38,
    "version": 1,
    "time": {
      "from": "now-15m",
      "to": "now"
    }
  }
}

